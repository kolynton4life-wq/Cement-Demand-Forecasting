# Streamlit dashboard container — the deployment-specific alternative to
# Dockerfile.dashboard (Dash). Both read the same data/processed/ outputs;
# neither trains models. See src/dashboard/streamlit_app.py's module
# docstring for why both dashboards exist side by side.
FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt streamlit>=1.30 plotly>=5.18

COPY src/dashboard/ ./src/dashboard/

EXPOSE 8501

CMD ["streamlit", "run", "src/dashboard/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
