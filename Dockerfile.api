# Prediction API container — serves forecasts from models trained by the
# model container (src/api.py via uvicorn). Does NOT train models itself;
# expects models/ to be populated already (mounted volume or built after
# the model container has run at least once).
FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/ ./src/

EXPOSE 8000

# --host 0.0.0.0 is required for the port to be reachable from outside
# the container (uvicorn defaults to 127.0.0.1, which docker-compose
# cannot route to).
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
