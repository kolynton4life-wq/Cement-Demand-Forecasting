# Copy this file to .env before running docker-compose.
# No real secrets are currently required — SQLite needs no credentials,
# and no external API keys are used yet. This file exists as the
# expected hook point for when real integrations are added (e.g. a
# weather forecast API key, replacing the same-period-prior-year proxy
# used in notebooks 05 and src/inference.py).

MAPE_ALERT_THRESHOLD=15.0
LEAD_TIME_DAYS=3
DASH_DEBUG=false

# Uncomment and fill in once a real weather forecast API replaces the
# same-period-prior-year proxy (see notebook 05, Section 2):
# WEATHER_API_KEY=
